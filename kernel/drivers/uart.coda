module drivers::uart;

include pcu;
include io;

mut uint32 base;

@export
fn bool init() {
    pcu::Device *? dev = pcu::find_device(0x12305010);
    
    if (dev == null) return false;
    if (dev.bar == 0 || dev.size < 1) return false;
    
    base = dev.bar;

    return true;
}

@export
fn none putc(uint8 c) {
    if (base == 0)
        return;
    
    io::write8((uint32 *)base, 0, c);
}

@export
fn none puts(uint8[] s) {
    if (base == 0)
        return;

    uint32 length = (uint32)s.len;

    for (mut uint32 i = 0; i < length; i += 1) {
        putc(s.ptr[i]);
    }
}

@export
fn none putx(uint32 value) {
    for (mut uint32 i = 0; i < 8; i += 1) {
        uint32 nibble = (value >> (28 - i * 4)) & 0xF;

        if (nibble < 10)
            putc((uint8)('0' + nibble));
        else
            putc((uint8)('A' + nibble - 10));
    }
}