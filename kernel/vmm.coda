module vmm;

include pmm;
include mem;
include cpu;
include io;

uint32 PAGE_SIZE = 4096;
uint32 PAGE_SHIFT = 12;
uint32 PAGE_MASK = 0xFFF;

uint32 PAGE_ENTRY_COUNT = 1024;
uint32 PAGE_INDEX_MASK = 0x3FF;

uint32 PAGE_FRAME_MASK = 0xFFFFF000;

uint32 PDE_PRESENT = 0x01;

uint32 PTE_EXECUTABLE = 0x01;
uint32 PTE_CACHEABLE = 0x02;
uint32 PTE_USER = 0x04;
uint32 PTE_WRITABLE = 0x08;
uint32 PTE_PRESENT = 0x10;

uint32 PTE_TLB_MASK = 0xFFFFF00F;

type PageEntry = uint32;

@export
type AddressSpace = struct {
    uint32 directory_phys;
    uint32 asid;
};

uint32 KERNEL_BASE = 0xC0000000;
uint32 KERNEL_DIRECT_MAP_LIMIT = 0x01000000;
uint32 KERNEL_PDE_INDEX = 768;
uint32 KERNEL_DIRECT_MAP_PHYS_BASE = 0x00020000;

mut AddressSpace kernel_space;

mut bool vm_active = false;

fn mut uint32 *page_table_ptr(uint32 physical, bool force_physical = false) {
    if (physical < KERNEL_DIRECT_MAP_PHYS_BASE ||
        (physical & PAGE_MASK) != 0 ||
        physical >= KERNEL_DIRECT_MAP_LIMIT)
        cpu::halt();

    if (vm_active && !force_physical)
        return (uint32 *)(KERNEL_BASE + physical);

    return (uint32 *)physical;
}

fn uint32 directory_index(uint32 address) {
    return (address >> 22) & PAGE_INDEX_MASK;
}

fn uint32 table_index(uint32 address) {
    return (address >> PAGE_SHIFT) & PAGE_INDEX_MASK;
}

fn uint32 page_offset(uint32 address) {
    return address & PAGE_MASK;
}

fn uint32 PageEntry.frame(PageEntry entry) {
    return entry & PAGE_FRAME_MASK;
}

fn uint32 PageEntry.tlb_value(PageEntry entry) {
    return entry & PTE_TLB_MASK;
}

fn (PageEntry | none) AddressSpace.lookup_impl(AddressSpace space, uint32 address, bool force_physical) {
    uint32 *directory = (uint32 *)page_table_ptr(space.directory_phys, force_physical);

    uint32 pde = directory[directory_index(address)];

    if ((pde & PDE_PRESENT) == 0)
        return;

    uint32 *table = (uint32 *)page_table_ptr(PageEntry.frame(pde), force_physical);

    uint32 pte = table[table_index(address)];

    if ((pte & PTE_PRESENT) == 0)
        return;

    return (PageEntry)pte;
}

fn (PageEntry | none) AddressSpace.lookup(AddressSpace space, uint32 address) {
    return space.lookup_impl(address, false);
}

fn (PageEntry | none) AddressSpace.lookup_phys(AddressSpace space, uint32 address) {
    return space.lookup_impl(address, true);
}

fn (AddressSpace | none) AddressSpace.create() {
    match (pmm::alloc_below(KERNEL_DIRECT_MAP_LIMIT)) {
        uint32 address: {
            mem::set((none *)page_table_ptr(address), 0, PAGE_SIZE);

            mut AddressSpace space = {.directory_phys = address};

            match (alloc_asid()) {
                uint32 asid: {
                    space.asid = asid;
                    return space;
                }

                AsidError: {
                    pmm::free(address);
                    return;
                }
            }
        }

        none: return;
    }
}

type VmmError = enum {
    OutOfMemory,
    MisalignedAddress,
    InvalidPhysicalAddress,
    InvalidFlags,
    AlreadyMapped,
    NotMapped,
    InvalidAddressSpace,
    ActiveAddressSpace,
    PmmFailure,
    InvalidAsid,
    InvalidFault,
    InvalidVirtualAddress,
};

@export
fn (none | VmmError) AddressSpace.destroy(mut AddressSpace *space) {
    if (space.directory_phys == 0)
        return VmmError::InvalidAddressSpace;

    if (space.asid == 0 || space.asid >= ASID_COUNT || !asid_is_allocated(space.asid))
        return VmmError::InvalidAsid;

    if (active_space.directory_phys != 0 && (active_space.directory_phys == space.directory_phys || active_space.asid == space.asid))
        return VmmError::ActiveAddressSpace;

    tlb_invalidate_asid(space.asid);

    mut uint32 *directory = (uint32 *)page_table_ptr(space.directory_phys);

    for (mut uint32 i = 0; i < KERNEL_PDE_INDEX; i += 1) {
        uint32 pde = directory[i];

        if ((pde & PDE_PRESENT) == 0)
            continue;

        uint32 table_phys = pde & PAGE_FRAME_MASK;

        match (pmm::free(table_phys)) {
            none: directory[i] = 0;

            pmm::FreeError: return VmmError::PmmFailure;
        }
    }

    match (pmm::free(space.directory_phys)) {
        none: {
            match (release_asid(space.asid)) {
                AsidError: return VmmError::InvalidAsid;
                none: {
                    space.directory_phys = 0;
                    space.asid = 0;
                    return;
                }
            }
        }

        pmm::FreeError: return VmmError::PmmFailure;
    }
}

fn (uint32 | none) AddressSpace.get_or_create_table(mut AddressSpace *space, uint32 address) {
    mut uint32 *directory = (uint32 *)page_table_ptr(space.directory_phys);

    uint32 index = directory_index(address);
    uint32 pde = directory[index];

    if ((pde & PDE_PRESENT) != 0)
        return pde & PAGE_FRAME_MASK;

    match (pmm::alloc_below(KERNEL_DIRECT_MAP_LIMIT)) {
        uint32 table_phys: {
            mem::set((mut none *)page_table_ptr(table_phys), 0, PAGE_SIZE);
            directory[index] = table_phys | PDE_PRESENT;
            return table_phys;
        }

        none: return;
    }
}

uint32 PTE_PERMISSION_MASK = 0x0F;

fn (none | VmmError) map_page(mut AddressSpace *space, uint32 virtual_address, uint32 physical_address, uint32 flags) {
    if (space.directory_phys == 0)
        return VmmError::InvalidAddressSpace;

    if ((virtual_address & PAGE_MASK) != 0 ||
        (physical_address & PAGE_MASK) != 0)
        return VmmError::MisalignedAddress;

    if (physical_address == 0)
        return VmmError::InvalidPhysicalAddress;

    if ((flags & ~PTE_PERMISSION_MASK) != 0)
        return VmmError::InvalidFlags;

    mut uint32 table_phys = 0;

    match (space.get_or_create_table(virtual_address)) {
        uint32 address: table_phys = address;
        none: return VmmError::OutOfMemory;
    }

    mut uint32 *table = (uint32 *)page_table_ptr(table_phys);
    uint32 index = table_index(virtual_address);

    if ((table[index] & PTE_PRESENT) != 0)
        return VmmError::AlreadyMapped;

    table[index] = physical_address | flags | PTE_PRESENT;

    return;
}

@export
fn (none | VmmError) AddressSpace.map(mut AddressSpace *space, uint32 virtual_address, uint32 physical_address, uint32 flags) {
    if (virtual_address >= KERNEL_BASE)
        return VmmError::InvalidVirtualAddress;

    return map_page(space, virtual_address, physical_address, flags);
}

@export
fn (none | VmmError) kernel_map(uint32 virtual_address, uint32 physical_address, uint32 flags) {
    if (virtual_address < KERNEL_BASE)
        return VmmError::InvalidVirtualAddress;

    if (kernel_space.directory_phys == 0 || kernel_space.asid != 0)
        return VmmError::InvalidAddressSpace;

    if ((flags & PTE_USER) != 0)
        return VmmError::InvalidFlags;

    return map_page(&kernel_space, virtual_address, physical_address, flags);
}

fn none tlb_invalidate_page(uint32 virtual_address) {
    mut uint32 *mtu = (mut uint32 *)0x00010600;
    uint32 vpn = virtual_address & PAGE_FRAME_MASK;

    for (mut uint32 i = 0; i < 32; i += 1) {
        mtu[1] = i;

        uint32 hi = mtu[2];

        if ((hi & 1) == 0)
            continue;

        if ((hi & PAGE_FRAME_MASK) != vpn)
            continue;

        mtu[2] = hi & ~1;
    }
}

fn none tlb_invalidate(uint32 asid, uint32 virtual_address) {
    mut uint32 *mtu = (mut uint32 *)0x00010600;

    uint32 vpn = virtual_address & PAGE_FRAME_MASK;

    for (mut uint32 i = 0; i < 32; i += 1) {
        mtu[1] = i;

        uint32 hi = mtu[2];

        if ((hi & 1) == 0)
            continue;

        if ((hi & PAGE_FRAME_MASK) != vpn)
            continue;

        if (((hi >> 2) & 0x3FF) != asid)
            continue;

        // clear the valid bit.
        mtu[2] = hi & ~1;
    }
}

fn (PageEntry | none) unmap_page(mut AddressSpace *space, uint32 virtual_address) {
    mut uint32 *directory = (uint32 *)page_table_ptr(space.directory_phys);

    uint32 pde = directory[directory_index(virtual_address)];

    if ((pde & PDE_PRESENT) == 0)
        return;

    mut uint32 *table = (uint32 *)page_table_ptr(PageEntry.frame(pde));

    uint32 index = table_index(virtual_address);
    uint32 pte = table[index];

    if ((pte & PTE_PRESENT) == 0)
        return;

    table[index] = 0;

    return (PageEntry)pte;
}

@export
fn (PageEntry | VmmError) AddressSpace.unmap(mut AddressSpace *space, uint32 virtual_address) {
    if (virtual_address >= KERNEL_BASE)
        return VmmError::InvalidVirtualAddress;

    if (space.directory_phys == 0)
        return VmmError::InvalidAddressSpace;

    if ((virtual_address & PAGE_MASK) != 0)
        return VmmError::MisalignedAddress;

    match (unmap_page(space, virtual_address)) {
        PageEntry entry: {
            tlb_invalidate(space.asid, virtual_address);
            return entry;
        }

        none: return VmmError::NotMapped;
    }
}

@export
fn (PageEntry | VmmError) kernel_unmap(uint32 virtual_address) {
    if (virtual_address < KERNEL_BASE)
        return VmmError::InvalidVirtualAddress;

    if (kernel_space.directory_phys == 0 || kernel_space.asid != 0)
        return VmmError::InvalidAddressSpace;

    if ((virtual_address & PAGE_MASK) != 0)
        return VmmError::MisalignedAddress;

    match (unmap_page(&kernel_space, virtual_address)) {
        PageEntry entry: {
            tlb_invalidate_page(virtual_address);
            return entry;
        }

        none: return VmmError::NotMapped;
    }
}

fn none tlb_invalidate_asid(uint32 asid) {
    mut uint32 *mtu = (mut uint32 *)0x00010600;

    for (mut uint32 i = 0; i < 32; i += 1) {
        mtu[1] = i;

        uint32 hi = mtu[2];

        if ((hi & 1) == 0)
            continue;

        uint32 entry_asid = (hi >> 2) & 0x3FF;

        if (entry_asid != asid)
            continue;

        mtu[2] = hi & ~1;
    }
}

mut uint32 tlb_next_slot = 0;

fn (uint32 | VmmError) tlb_install(uint32 asid, uint32 virtual_address, PageEntry entry) {
    if (asid > 0x3FF)
        return VmmError::InvalidAsid;

    if ((entry & PTE_PRESENT) == 0)
        return VmmError::NotMapped;

    mut uint32 *mtu = (mut uint32 *)0x00010600;

    uint32 slot = tlb_next_slot;

    uint32 hi = (virtual_address & PAGE_FRAME_MASK)
              | (asid << 2)
              | 1;

    uint32 lo = entry & PTE_TLB_MASK;

    // select the replacement slot,
    // invalidate the old entry,
    // write the physical frame and permissions, and
    // commit the new entry by setting V last.
    mtu[1] = slot;
    mtu[2] = 0;
    mtu[3] = lo;
    mtu[2] = hi;

    tlb_next_slot = (slot + 1) & 31;

    return slot;
}

mut AddressSpace active_space;

@export
fn none activate(AddressSpace space) {
    if (space.directory_phys == 0 || space.asid == 0 || space.asid >= ASID_COUNT || !asid_is_allocated(space.asid))
        cpu::halt();

    if (active_space.directory_phys != 0) {
        if (active_space.asid == space.asid && active_space.directory_phys != space.directory_phys)
            cpu::halt();

        if (active_space.directory_phys == space.directory_phys && active_space.asid != space.asid)
            cpu::halt();
    }

    active_space = space;
    io::write32(0x00010600, 0x10, space.asid);
}

@export
fn (uint32 | VmmError) refill() {
    uint32 address = io::read32(0x00010600, 0x00);
    uint32 status  = io::read32(0x00010600, 0x14);
    uint32 asid    = io::read32(0x00010600, 0x10);

    if ((status & 0x1C) != 0)
        return VmmError::InvalidFault;

    if (address >= KERNEL_BASE) {
        if (kernel_space.directory_phys == 0)
            return VmmError::InvalidAddressSpace;

        if (active_space.directory_phys == 0) {
            if (asid != 0)
                return VmmError::InvalidAsid;
        } else if (asid != active_space.asid) {
            return VmmError::InvalidAsid;
        }

        match (kernel_space.lookup_phys(address)) {
            PageEntry entry: return tlb_install(asid, address, entry);
            none: return VmmError::NotMapped;
        }
    }

    // ASID 0 is reserved for the kernel address space.
    if (asid == 0) {
        if (active_space.directory_phys != 0)
            return VmmError::InvalidAsid;

        if (kernel_space.directory_phys == 0)
            return VmmError::InvalidAddressSpace;

        match (kernel_space.lookup_phys(address)) {
            PageEntry entry: return tlb_install(asid, address, entry);
            none: return VmmError::NotMapped;
        }
    }

    if (active_space.directory_phys == 0)
        return VmmError::InvalidAddressSpace;

    if (asid != active_space.asid)
        return VmmError::InvalidAsid;

    match (active_space.lookup_phys(address)) {
        PageEntry entry: return tlb_install(asid, address, entry);
        none: return VmmError::NotMapped;
    }
}

uint32 ASID_COUNT = 1024;
uint32 ASID_BITMAP_SIZE = 128;
uint32 ASID_USABLE_COUNT = 1023;

mut uint8[ASID_BITMAP_SIZE] asid_bitmap;
mut uint32 asid_search_hint = 1;

type AsidError = enum {
    Exhausted,
    Invalid,
    NotAllocated,
    Active,
};

fn bool asid_is_allocated(uint32 id) {
    if (id == 0 || id >= ASID_COUNT)
        return false;

    uint32 byte_index = id >> 3;
    uint8 bit = (uint8)(1 << (id & 7));

    return (asid_bitmap[byte_index] & bit) != 0;
}

fn (uint32 | AsidError) alloc_asid() {
    mut uint32 id = asid_search_hint;

    for (mut uint32 n = 0; n < ASID_USABLE_COUNT; n += 1) {
        uint32 byte_index = id >> 3;
        uint8 bit = (uint8)(1 << (id & 7));

        if ((asid_bitmap[byte_index] & bit) == 0) {
            asid_bitmap[byte_index] |= bit;

            asid_search_hint = id + 1;
            if (asid_search_hint == ASID_COUNT)
                asid_search_hint = 1;

            return id;
        }

        id += 1;
        if (id == ASID_COUNT)
            id = 1;
    }

    return AsidError::Exhausted;
}

fn (none | AsidError) release_asid(uint32 id) {
    if (id == 0 || id >= ASID_COUNT)
        return AsidError::Invalid;

    if (!asid_is_allocated(id))
        return AsidError::NotAllocated;

    if (active_space.directory_phys != 0 && active_space.asid == id)
        return AsidError::Active;

    tlb_invalidate_asid(id);

    uint32 byte_index = id >> 3;
    uint8 bit = (uint8)(1 << (id & 7));
    asid_bitmap[byte_index] &= (uint8)~bit;

    if (id < asid_search_hint)
        asid_search_hint = id;
}

fn none tlb_invalidate_all() {
    for (mut uint32 i = 0; i < 32; i += 1) {
        io::write32(0x00010600, 0x04, i);
        io::write32(0x00010600, 0x08, 0);
    }
}

@extern uint32 __text_start;
@extern uint32 __text_end;

@extern uint32 __rodata_start;
@extern uint32 __rodata_end;

@extern uint32 __data_start;
@extern uint32 __data_end;

@extern uint32 __bss_start;
@extern uint32 __bss_end;

@extern uint32 __exe_start;
@extern uint32 __exe_end;

fn bool page_overlaps(uint32 page, uint32 start, uint32 end) {
    return start < page + PAGE_SIZE && page < end;
}

fn uint32 direct_map_flags(uint32 physical) {
    bool text = page_overlaps(physical, __text_start, __text_end);
    bool rodata = page_overlaps(physical, __rodata_start, __rodata_end);
    bool data = page_overlaps(physical, __data_start, __data_end);
    bool bss = page_overlaps(physical, __bss_start, __bss_end);

    mut uint32 flags = PTE_CACHEABLE;

    if (text)
        flags |= PTE_EXECUTABLE;

    if (data || bss || (!text && !rodata))
        flags |= PTE_WRITABLE;

    return flags;
}

fn none build_direct_map() {
    mut uint32 *directory = (uint32 *)page_table_ptr(kernel_space.directory_phys);

    mut uint32 physical = KERNEL_DIRECT_MAP_PHYS_BASE;

    while (physical < KERNEL_DIRECT_MAP_LIMIT) {
        uint32 virtual_address = KERNEL_BASE + physical;
        uint32 pde_index = directory_index(virtual_address);

        if ((directory[pde_index] & PDE_PRESENT) != 0)
            cpu::halt();

        mut uint32 table_phys = 0;

        match (pmm::alloc_below(KERNEL_DIRECT_MAP_LIMIT)) {
            uint32 address: table_phys = address;
            none: cpu::halt();
        }

        mem::set((none *)page_table_ptr(table_phys), 0, PAGE_SIZE);

        mut uint32 *table = (uint32 *)page_table_ptr(table_phys);

        mut uint32 index = table_index(virtual_address);

        while (index < PAGE_ENTRY_COUNT && physical < KERNEL_DIRECT_MAP_LIMIT) {
            table[index] = physical | direct_map_flags(physical) | PTE_PRESENT;

            physical += PAGE_SIZE;
            index += 1;
        }

        directory[pde_index] = table_phys | PDE_PRESENT;
    }
}

@export
fn none enable_translation() {
    if (kernel_space.directory_phys == 0 || vm_active)
        cpu::halt();

    cpu::enable_vm();

    vm_active = true;
}

@export
fn none init() {
    if (kernel_space.directory_phys != 0)
        cpu::halt();

    vm_active = false;

    match (pmm::alloc_below(KERNEL_DIRECT_MAP_LIMIT)) {
        none: cpu::halt();

        uint32 address: {
            mem::set((none *)page_table_ptr(address), 0, PAGE_SIZE);

            kernel_space = {
                .directory_phys = address,
                .asid = 0,
            };
        }
    }

    build_direct_map();

    // identity map the kernel image.
    mut uint32 page = __exe_start & PAGE_FRAME_MASK;
    uint32 image_end = (__exe_end + PAGE_MASK) & PAGE_FRAME_MASK;

    while (page < image_end) {
        match (map_page(&kernel_space, page, page, direct_map_flags(page))) {
            none: {}
            _: cpu::halt();
        }

        page += PAGE_SIZE;
    }

    // identity map the system registers and IHVT.
    match (map_page(&kernel_space, 0x00010000, 0x00010000, PTE_WRITABLE)) {
        none: {}
        _: cpu::halt();
    }

    // identity map the 64 KiB kernel stack.
    for (mut uint32 i = 0; i < 16; i += 1) {
        page = 0xFFFF0000 + i * PAGE_SIZE;

        match (map_page(&kernel_space, page, page, PTE_WRITABLE | PTE_CACHEABLE)) {
            none: {}
            _: cpu::halt();
        }
    }

    tlb_invalidate_all();
    io::write32(0x00010600, 0x10, 0);
}