module int::ihvt;

include int::timer : timer;
include int::irq : irq;
include drivers::uart : uart;
include vmm;
include cpu;
include io;
include proc::sched : sched;
include syscall;

@export
fn none int_handler(uint8 num, mut uint32 *frame) {
    if (num >= 0x20 && num < 0xFF) {
        irq::dispatch(num);
    } else if (num == 0x05 || num == 0x06) {
        match (vmm::refill()) {
            uint32: frame[0] -= 4;
            vmm::VmmError error: {
                mut uint32 *mtu = (mut uint32 *)0x10600;

                uart::puts("TLB refill failed\n");

                uart::puts("Error: ");
                uart::putx((uint32)error);

                uart::puts("\nAddress: ");
                uart::putx(io::read32(mtu, 0x00));

                uart::puts("\nStatus: ");
                uart::putx(io::read32(mtu, 0x14));

                uart::puts("\nASID: ");
                uart::putx(io::read32(mtu, 0x10));

                uart::puts("\nFaulting PC: ");
                uart::putx(frame[0] - 4);

                uart::putc('\n');
                panic("Unmapped page fault");
            }
        }
    } else if (num == 0x08) {
        uart::puts("User syscall reached\n");
        // sched::schedule(frame);
        syscall::dispatch(frame);
    } else {
        panic("Unhandled exception");
    }

    return;
}

@extern none *__ihvt_start;
@extern none *__ihvt_end;

fn none install_handlers() {
    mut uint32 *ihvt = (uint32 *)0x00010000;

    for (mut uint32 i = 0; i < 256; i += 1) {
        ihvt[i] = ((uint32 *)__ihvt_start)[i];
    }
}

@export
fn none init() {
    install_handlers();
}