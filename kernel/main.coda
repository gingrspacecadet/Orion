include int::timer : timer;
include int::ihvt : ihvt;
include cpu;
include mem;
include pmm;
include vmm;
include pcu;
include lib::alloc : alloc;
include drivers::uart : uart;
include proc;
include proc::sched;

@extern none *__bss_start;
@extern none *__bss_end;

fn none clear_bss() {
    mem::set(__bss_start, 0, __bss_end - __bss_start);
}

fn none print_hex(uint32 value) {
    for (mut uint32 i = 0; i < 8; i += 1) {
        uint32 nibble = (value >> (28 - i * 4)) & 0xF;

        if (nibble < 10)
            uart::putc((uint8)('0' + nibble));
        else
            uart::putc((uint8)('A' + nibble - 10));
    }
}

@extern uint32 __exe_end;

uint32[3] user_words = {
    0x080000A8,
    0x8C000000,
    0x47FFFFFF,
};

@export
fn uint32 main() {
    clear_bss();

    pcu::init();
    uart::init();
    pmm::init();
    vmm::init();
    alloc::init();
    ihvt::init();
    timer::init();

    vmm::enable_translation();

    uart::puts("Hello, bob!\n");

    uart::puts("Creating processes\n");

    mut proc::Process first = proc::Process.create().unwrap();
    mut proc::Process second = proc::Process.create().unwrap();

    uint8[] user_image = {
        .len = 12,
        .ptr = (uint8 *)&user_words[0],
    };

    uart::puts("Loading first process\n");
    first.load(user_image, 0).unwrap();

    uart::puts("Loading second process\n");
    second.load(user_image, 0).unwrap();

    if (!proc::sched::add(&first))
        panic("Failed to register first process");

    if (!proc::sched::add(&second))
        panic("Failed to register second process");

    uart::puts("Starting scheduler\n");
    proc::sched::start();

    return 0;
}