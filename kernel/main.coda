include int::timer : timer;
include int::ihvt : ihvt;
include cpu;
include mem;
include pmm;
include vmm;

@extern none *__bss_start;
@extern none *__bss_end;

fn none clear_bss() {
    mem::set(__bss_start, 0, __bss_end - __bss_start);
}

@export
fn uint32 main() {
    clear_bss();

    pmm::init();
    vmm::init();
    ihvt::init();
    timer::init();

    vmm::enable_translation();
    cpu::enable_ints();

    // while (timer_ticks < 500) {}
    // cpu::halt();
    return 67;
}