include int::timer : timer;
include int::ihvt : ihvt;
include cpu;
include mem;
include pmm;
include vmm;
include pcu;
include lib::alloc : alloc;
include drivers::uart : uart;

@extern none *__bss_start;
@extern none *__bss_end;

fn none clear_bss() {
    mem::set(__bss_start, 0, __bss_end - __bss_start);
}

@export
fn uint32 main() {
    clear_bss();

    pmm::init();
    pcu::init();
    vmm::init();
    alloc::init();
    ihvt::init();
    timer::init();

    vmm::enable_translation();
    cpu::enable_ints();

    mut uint32 *? t = (uint32 *?)alloc::alloc(#sizeof(uint32));
    if (t != null) {
        *t = 0x69;
    }

    uart::putc('A');
    uart::putc('\n');

    if (t != null) {
        return *t;
    } else {
        return 0x42;
    }
}