module proc;

include vmm;
include pmm;
include io;
include lib::alloc : lib;

@extern
fn none enter_user(uint32 pc, uint32 flags);

@export
type ProcessState = enum {
    Created,
    Ready,
    Running,
    Exited,
};

type UserContext = struct {
    uint32[16] registers;
    uint32 pc;
    uint32 flags;
};

@export
type Process = struct {
    uint32 pid;
    ProcessState state;
    vmm::AddressSpace address_space;

    UserContext user_context;

    uint32 program_page_count;
    uint32 stack_page_count;

    uint32 exit_code;
};

mut uint32 next_pid = 1;

type ProcessError = enum {
    OutOfMemory,
    NoAvailablePid,
    AddressSpaceFailure,
    InvalidState,
    InvalidProgram,
    InvalidEntryPoint,
    ProgramTooLarge,
};

@export
fn (Process | ProcessError) Process.create() {
    if (next_pid == 0xFFFFFFFF)
        return ProcessError::NoAvailablePid;

    mut Process p = {.pid = next_pid};
    
    match (vmm::AddressSpace.create()) {
        none: return ProcessError::AddressSpaceFailure;
        vmm::AddressSpace space: p.address_space = space;
    }

    next_pid += 1;
    p.state = ProcessState::Created;

    return p;
}

uint32 USER_PROGRAM_BASE = 0x00400000;

uint32 USER_STACK_PAGE_COUNT = 4;
uint32 USER_STACK_SIZE = USER_STACK_PAGE_COUNT * vmm::PAGE_SIZE;
uint32 USER_STACK_TOP = vmm::KERNEL_BASE;
uint32 USER_STACK_BASE = USER_STACK_TOP - USER_STACK_SIZE;

fn (uint32 | ProcessError) alloc_user_frame() {
    match (pmm::alloc_below(vmm::KERNEL_DIRECT_MAP_LIMIT)) {
        none: return ProcessError::OutOfMemory;

        uint32 physical: {
            mut uint8 *bytes = (mut uint8 *)(vmm::KERNEL_BASE + physical);

            for (mut uint32 i = 0; i < vmm::PAGE_SIZE; i += 1) {
                bytes[i] = 0;
            }

            return physical;
        }
    }
}


fn (none | ProcessError) map_user_page(mut Process *process, uint32 virtual_address, uint32 physical_address, uint32 flags) {
    match (vmm::AddressSpace.map(&process.address_space, virtual_address, physical_address, flags)) {
        none: return;

        vmm::VmmError err: {
            if (err == vmm::VmmError::OutOfMemory) return ProcessError::OutOfMemory;
            else return ProcessError::AddressSpaceFailure;
        }
    }
}


fn none free_user_frame(uint32 physical_address) {
    match (pmm::free(physical_address)) {
        none: {}
        _: panic("Failed to free process page");
    }
}


fn none release_user_pages(mut Process *process, uint32 virtual_base, uint32 page_count) {
    for (mut uint32 i = 0; i < page_count; i += 1) {
        uint32 address = virtual_base + i * vmm::PAGE_SIZE;

        match (vmm::AddressSpace.unmap_physical(&process.address_space, address)) {
            uint32 physical: free_user_frame(physical);
            _: panic("Failed to roll back process mapping");
        }
    }
}

@export
fn (none | ProcessError) Process.load(mut Process *process, uint8[] program, uint32 entry_point) {
    if (process.state != ProcessState::Created)
        return ProcessError::InvalidState;

    if (program.len == 0)
        return ProcessError::InvalidProgram;

    uint32 maximum_program_size = USER_STACK_BASE - USER_PROGRAM_BASE;

    if (program.len > (uint64)maximum_program_size)
        return ProcessError::ProgramTooLarge;

    uint32 program_size = (uint32)program.len;

    if ((entry_point & 3) != 0 || (uint64)entry_point > program.len || program.len - (uint64)entry_point < 4)
        return ProcessError::InvalidEntryPoint;

    uint32 program_pages = (program_size + vmm::PAGE_SIZE - 1) / vmm::PAGE_SIZE;

    uint32 program_flags = vmm::PTE_USER | vmm::PTE_EXECUTABLE | vmm::PTE_CACHEABLE;

    uint32 stack_flags = vmm::PTE_USER | vmm::PTE_WRITABLE | vmm::PTE_CACHEABLE;

    mut uint32 mapped_program_pages = 0;
    mut uint32 mapped_stack_pages = 0;

    for (mut uint32 i = 0; i < program_pages; i += 1) {
        mut uint32 physical = 0;

        match (alloc_user_frame()) {
            uint32 address: physical = address;

            ProcessError error: {
                release_user_pages(process, USER_PROGRAM_BASE, mapped_program_pages);
                return error;
            }
        }

        uint32 source_offset = i * vmm::PAGE_SIZE;
        mut uint32 copy_size = program_size - source_offset;

        if (copy_size > vmm::PAGE_SIZE)
            copy_size = vmm::PAGE_SIZE;

        mut uint8 *destination = (mut uint8 *)(vmm::KERNEL_BASE + physical);

        for (mut uint32 j = 0; j < copy_size; j += 1) {
            destination[j] = program.ptr[source_offset + j];
        }

        uint32 virtual_address = USER_PROGRAM_BASE + i * vmm::PAGE_SIZE;

        match (map_user_page(process, virtual_address, physical, program_flags)) {
            none: mapped_program_pages += 1;

            ProcessError error: {
                free_user_frame(physical);

                release_user_pages(process, USER_PROGRAM_BASE, mapped_program_pages);

                return error;
            }
        }
    }


    for (mut uint32 i = 0; i < USER_STACK_PAGE_COUNT; i += 1) {
        mut uint32 physical = 0;

        match (alloc_user_frame()) {
            uint32 address: physical = address;

            ProcessError error: {
                release_user_pages(process, USER_STACK_BASE, mapped_stack_pages);

                release_user_pages(process, USER_PROGRAM_BASE, mapped_program_pages);

                return error;
            }
        }

        uint32 virtual_address = USER_STACK_BASE + i * vmm::PAGE_SIZE;

        match (map_user_page(process, virtual_address, physical, stack_flags)) {
            none: mapped_stack_pages += 1;

            ProcessError error: {
                free_user_frame(physical);

                release_user_pages(process, USER_STACK_BASE, mapped_stack_pages);
                release_user_pages(process, USER_PROGRAM_BASE, mapped_program_pages);

                return error;
            }
        }
    }


    process.program_page_count = mapped_program_pages;
    process.stack_page_count = mapped_stack_pages;

    for (mut uint32 i = 0; i < 16; i += 1) {
        process.user_context.registers[i] = 0;
    }

    process.user_context.registers[15] = USER_STACK_TOP;
    process.user_context.pc = USER_PROGRAM_BASE + entry_point;

    process.user_context.flags = 0x04;

    process.exit_code = 0;
    process.state = ProcessState::Ready;

    return;
}

@export
fn none Process.start(mut Process *process) {
    if (process.state != ProcessState::Ready)
        panic("Cannot start a process that is not ready");

    uint32 pc = process.user_context.pc;
    uint32 flags = process.user_context.flags;

    // Restore the inactive user register bank before changing ASIDs
    mut uint32 *mtu = (mut uint32 *)0x00010600;

    for (mut uint32 i = 0; i < 16; i += 1) {
        io::write32(mtu, 0x40 + i * 4, process.user_context.registers[i]);
    }

    process.state = ProcessState::Running;

    vmm::activate(process.address_space);

    enter_user(pc, flags);

    panic("User-mode entry unexpectedly returned");
}
