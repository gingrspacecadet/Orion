module pcu;

include io;

uint32 PCU_ADDR = 0x10800;

@export
type Device = struct {
    uint32 id;
    uint32 bar;
    uint32 size;
    uint32 irq;
};

mut Device[16] devices;

fn none enumerate() {
    for (mut uint8 i = 0; i < 16; i += 1) {
        uint32 id = io::read32(PCU_ADDR + i * 16, 0x00);
        
        if (id == 0)
            continue;

        uint32 bar = io::read32(PCU_ADDR + i * 16, 0x04);
        uint32 size = io::read32(PCU_ADDR + i * 16, 0x08);
        uint32 irq = io::read32(PCU_ADDR + i * 16, 0x0C);

        if (size == 0 || ((size & (size - 1)) != 0))
            continue;

        // Firmware ensures BARs and IRQs are 0 (uninit)

        devices[i] = {
            .id = id,
            .bar = bar,
            .size = size,
            .irq = irq,
        };
    }
}

fn none assign_bars() {
    mut uint32 addr = 0x00010900;

    for (mut uint8 i = 0; i < 16; i += 1) {
        Device dev = devices[i];

        if (dev.bar != 0 || dev.size == 0)
            continue;

        uint32 target_addr = (((addr + dev.size - 1) / dev.size) * dev.size);
        if (target_addr + dev.size >= 0x0001FFFF) {
            // error?
            continue;
        }

        io::write32(PCU_ADDR + i * 16, 0x04, target_addr);

        // check to see if write was successful
        if (io::read32(PCU_ADDR + i * 16, 0x04) != target_addr) {
            // error
            continue;
        }

        devices[i].bar = target_addr;
    }
}

@export
fn none init() {
    enumerate();
    assign_bars();
}

@export
fn Device *? find_device(uint32 id) {
    for (mut uint8 i = 0; i < 16; i += 1) {
        if (devices[i].id == id)
            return (Device*?)&devices[i];
    }

    return null;
}