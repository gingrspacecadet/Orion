module syscall;

include cpu;
include proc::sched : sched;
include proc;
include drivers::uart : uart;

@export
fn none dispatch(mut uint32 *frame) {
    uint32 num = cpu::get_user_reg(0);

    uart::puts("Received syscall ");
    uart::putx(num);
    uart::putc('\n');

    if (num == 0) {
        sched::schedule(frame);
    } else if (num == 1) {
        mut proc::Process *p = sched::get_active();
        p.exit_code = cpu::get_user_reg(1);
        p.state = proc::ProcessState::Exited;
        sched::schedule(frame);
    } else if (num == 2) {
        uart::puts({.ptr = (uint8 *)cpu::get_user_reg(1), .len = cpu::get_user_reg(2)});
    }
}